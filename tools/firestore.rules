rules_version = '2';
// Typing Zen's Firestore rules (paste into Firebase console > Firestore Database > Rules, then Publish).
// Each Google user can read and write only their own progress: typingZen.users/{uid} and its sessions, on the
// live site; typingZen.users-test/{uid} on the test site. Nothing else can be read or written.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{uid}/{rest=**} {
      allow read, write: if (col == "typingZen.users" || col == "typingZen.users-test")
        && request.auth != null && request.auth.uid == uid;
    }
  }
}
